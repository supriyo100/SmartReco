.env
.venv/
__pycache__/
*.pyc
.coverage
htmlcov/
.pytest_cache/

# NOT `data/` — that directory holds the curated course catalog and the JSON
# standard (data/COURSE_SCHEMA.md, data/course.schema.json, data/data_1/*.json),
# which are hand-written source and must be tracked. Ignore the runtime
# artifacts that happen to live there instead: DATABASE_URL points at
# ./data/smartreco.db, and catalog.index.json is regenerated by every ingest.
data/*.db
data/*.db-wal
data/*.db-shm
data/catalog.index.json

# Uploaded resumes are personal data supplied by users. They are runtime
# artifacts, not source, and must never be committed.
data/resumes/

# Rendered emails written by the SMTP fallback. They contain real user names,
# addresses and resume analysis — same personal-data reasoning as resumes above.
data/outbox_mail/

chroma_data/
*.db
*.db-wal
*.db-shm
.langgraph_api/
