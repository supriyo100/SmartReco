# --- Hackathon submission ---
# CI reads this from the GitHub repo secret (secrets.SUBMISSION_TOKEN), NOT from
# this file. Kept here so the variable is documented; .env itself is gitignored.
SUBMISSION_TOKEN=

# --- Mesh API (mandatory: ALL LLM + embedding calls go through Mesh) ---
MESH_API_KEY=rsk_your_key_here
MESH_BASE_URL=https://api.meshapi.ai/v1
MODEL_FAST=google/gemini-2.5-flash
MODEL_FAST_FALLBACK=openai/gpt-4o-mini
MODEL_WRITER=openai/gpt-4o
EMBED_MODEL=openai/text-embedding-3-small

# --- App ---
SECRET_KEY=change_me_long_random
DATABASE_URL=sqlite+aiosqlite:///./data/smartreco.db
CHROMA_DIR=./chroma_data
ENV=development

# --- Agent policy (arch v2 §3, v1 §5.2) ---
RERANK_MODE=fusion              # fusion | cross_encoder | llm
FINGERPRINT_COS_THRESHOLD=0.15
TRIGGER_MIN_EVENTS=8
TRIGGER_DEBOUNCE_S=90
REC_STALE_HOURS=6
COLD_START_MIN_EVENTS=3

# --- Scheduler ---
# APScheduler runs in-process. SINGLE WORKER ONLY (uvicorn --workers 1):
# two workers drain the outbox twice concurrently.
SCHEDULER_ENABLED=true
DIGEST_HOUR=16                  # local hour (Asia/Kolkata) for the daily digest
REENGAGE_AFTER_DAYS=7           # days of silence before a user counts as idle

# --- Email ---
# Leave SMTP_HOST/USER/PASS blank and mail still "sends": each message is
# rendered and written to data/outbox_mail/*.eml instead. That is the supported
# credential-less mode for tests, CI and demos — not an error path.
#
# For Gmail, SMTP_PASS must be a 16-character App Password (Google account →
# Security → App passwords), NOT the account password. Treat it as a secret:
# .env is gitignored, and an app password that leaks should be revoked and
# regenerated rather than reused.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587                   # 587 = STARTTLS, 465 = implicit TLS
SMTP_USER=
SMTP_PASS=
MAIL_FROM=                      # defaults to SMTP_USER; Gmail rewrites anything else
MAIL_FROM_NAME=SmartReco
# Links inside an email must be absolute — a relative href is dead in an inbox.
# Set this to the real origin before sending to anyone but yourself.
PUBLIC_BASE_URL=http://localhost:8000

# --- Observability (bonus) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=smartreco
